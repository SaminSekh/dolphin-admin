    <!-- Patch: Fast image loading with blur-up progressive enhancement -->
    <style>
        /* Always show images — never hide them */
        .public-product-img img,
        .public-product-img img[data-compress-src],
        .public-product-img img[data-lazy-src] {
            opacity: 1 !important;
            filter: none !important;
        }
    </style>
    <script>
    // ── IMAGE FIX: MutationObserver approach ─────────────────────────────────
    // Instead of overriding applyCompressedImages (which has timing issues),
    // we watch the DOM directly. The moment any <img> with data-compress-src
    // appears, we grab the real URL and set it as src immediately.
    // This works regardless of script load order or function call timing.

    (function() {
        function fixImg(img) {
            var url = img.getAttribute('data-compress-src') || img.getAttribute('data-lazy-src');
            if (!url) return;
            // Set real image URL immediately — goodbye SVG placeholder
            img.src = url;
            img.removeAttribute('data-compress-src');
            img.removeAttribute('data-lazy-src');
        }

        function fixAllImgs() {
            document.querySelectorAll('img[data-compress-src], img[data-lazy-src]').forEach(fixImg);
        }

        // Watch for any new images added to the DOM
        var mo = new MutationObserver(function(mutations) {
            mutations.forEach(function(m) {
                m.addedNodes.forEach(function(node) {
                    if (!node || node.nodeType !== 1) return;
                    // Direct match
                    if (node.tagName === 'IMG' && (node.hasAttribute('data-compress-src') || node.hasAttribute('data-lazy-src'))) {
                        fixImg(node);
                    }
                    // Children
                    node.querySelectorAll && node.querySelectorAll('img[data-compress-src], img[data-lazy-src]').forEach(fixImg);
                });
                // Also catch attribute changes (if src is set after add)
                if (m.type === 'attributes' && m.target.tagName === 'IMG') {
                    var t = m.target;
                    if (t.hasAttribute('data-compress-src') || t.hasAttribute('data-lazy-src')) fixImg(t);
                }
            });
        });

        // Observe the whole document body for any DOM changes
        document.addEventListener('DOMContentLoaded', function() {
            mo.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-compress-src', 'data-lazy-src'] });
            // Fix anything already in DOM
            fixAllImgs();
        });

        // Also run immediately in case DOMContentLoaded already fired
        if (document.readyState !== 'loading') {
            mo.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-compress-src', 'data-lazy-src'] });
            fixAllImgs();
        }
    })();
    </script>
    <script>
    (function() {
        // 1. MutationObserver to catch any spec-chip that contains URLs and remove it
        // AND fix variant buttons to show name only (no price)
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(m) {
                m.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1) {
                        // Remove spec chips with URLs
                        const chips = node.classList && node.classList.contains('spec-chip') ? [node] : (node.querySelectorAll ? node.querySelectorAll('.spec-chip') : []);
                        chips.forEach(function(chip) {
                            const text = chip.textContent || '';
                            const lowerText = text.toLowerCase();
                            if (lowerText.includes('://') || lowerText.includes('variant image') || lowerText.includes('product_image') || lowerText.includes('supabase')) {
                                chip.remove();
                            }
                        });
                        // Fix variant buttons: remove price, show only name
                        const varBtns = node.classList && node.classList.contains('variant-select-btn') ? [node] : (node.querySelectorAll ? node.querySelectorAll('.variant-select-btn') : []);
                        varBtns.forEach(function(btn) {
                            // The button has: <img> <span>name</span> <span>price</span>
                            // Remove the last span (price)
                            const spans = btn.querySelectorAll('span');
                            if (spans.length >= 2) {
                                spans[spans.length - 1].remove();
                            }
                        });
                    }
                });
            });
        });
        document.addEventListener('DOMContentLoaded', function() {
            const specsContainer = document.getElementById('detailSpecs');
            if (specsContainer) observer.observe(specsContainer, { childList: true, subtree: true });
            const modal = document.getElementById('productDetailModal');
            if (modal) observer.observe(modal, { childList: true, subtree: true });
        });

        // 2. Override openProductDetail to show ALL images (primary + all variant images)
        function patchApp() {
            if (!window.app) return;
            const origOpen = window.app.openProductDetail.bind(window.app);

            window.app.openProductDetail = async function(productId) {
                // Call original
                await origOpen(productId);

                // After original runs, fix the thumbnail gallery to include ALL images
                const product = this.products.find(p => p.id === productId);
                if (!product) return;

                const thumbs = document.getElementById('detailThumbnails');
                const img = document.getElementById('detailImage');
                if (!thumbs || !img) return;

                // Collect ALL primary images
                let primaryImages = [];
                if (product.product_image) primaryImages.push(product.product_image);
                let extraImgs = product.product_images || [];
                if (typeof extraImgs === 'string') { try { extraImgs = JSON.parse(extraImgs); } catch(e) { extraImgs = []; } }
                if (Array.isArray(extraImgs)) extraImgs.forEach(u => { if (u && !primaryImages.includes(u)) primaryImages.push(u); });
                // Metadata fallback
                let meta = product.metadata || {};
                if (typeof meta === 'string') { try { meta = JSON.parse(meta); } catch(e) { meta = {}; } }
                if (meta.product_images && Array.isArray(meta.product_images)) {
                    meta.product_images.forEach(u => { if (u && !primaryImages.includes(u)) primaryImages.push(u); });
                }

                // Load variants
                let variants = [];
                try {
                    const { data } = await supabaseClient.from('product_variants').select('*').eq('product_id', productId).eq('is_active', true).order('created_at');
                    if (data) variants = data;
                } catch(e) {}

                // Collect ALL variant images and build map
                const imageToVariantMap = {};
                const allVariantImageUrls = [];
                variants.forEach(v => {
                    let vAttrs = v.attributes || {};
                    if (typeof vAttrs === 'string') { try { vAttrs = JSON.parse(vAttrs); } catch(e) { vAttrs = {}; } }
                    const vImgs = vAttrs.variant_images || [];
                    // Add image_url
                    if (v.image_url && !primaryImages.includes(v.image_url)) {
                        imageToVariantMap[v.image_url] = v;
                        if (!allVariantImageUrls.includes(v.image_url)) allVariantImageUrls.push(v.image_url);
                    }
                    // Add all variant_images
                    vImgs.forEach(u => {
                        if (u && !primaryImages.includes(u)) {
                            imageToVariantMap[u] = v;
                            if (!allVariantImageUrls.includes(u)) allVariantImageUrls.push(u);
                        }
                    });
                });

                // Build complete image list
                const fullImageList = [...primaryImages, ...allVariantImageUrls.filter(u => !primaryImages.includes(u))];

                // Update image counter
                const counter = document.getElementById('pdpImgCounter');
                if (counter) counter.textContent = '1/' + fullImageList.length;

                // Compare with current thumbnails count
                const currentThumbs = thumbs.querySelectorAll('.detail-thumb').length;
                if (currentThumbs >= fullImageList.length) return; // Already correct

                // Rebuild thumbnails
                thumbs.innerHTML = '';
                const self = this;
                const currency = this.shopSettings?.currency || 'INR';

                if (fullImageList.length > 1) {
                    // Ensure main image shows first (primary) image to match the first highlighted thumbnail
                    const firstUrl = fullImageList[0];
                    if (firstUrl) {
                        img.setAttribute('data-original-src', firstUrl);
                        if (typeof compressImageUrl === 'function') {
                            compressImageUrl(firstUrl, 600, 0.7).then(c => { img.src = c; });
                        } else {
                            img.src = firstUrl;
                        }
                    }

                    fullImageList.forEach((url, idx) => {
                        const t = document.createElement('img');
                        t.className = 'detail-thumb' + (idx === 0 ? ' active' : '');
                        t.style.border = idx === 0 ? '2px solid var(--public-primary)' : '2px solid transparent';
                        t.setAttribute('data-original-url', url);
                        if (typeof compressImageUrl === 'function') {
                            compressImageUrl(url, 60, 0.3).then(c => { t.src = c; });
                        } else {
                            t.src = url;
                        }
                        t.onclick = () => {
                            if (typeof compressImageUrl === 'function') {
                                img.setAttribute('data-original-src', url);
                                compressImageUrl(url, 600, 0.7).then(c => { img.src = c; });
                            } else {
                                img.src = url;
                            }
                            thumbs.querySelectorAll('.detail-thumb').forEach(el => { el.classList.remove('active'); el.style.border = '2px solid transparent'; });
                            t.classList.add('active');
                            t.style.border = '2px solid var(--public-primary)';

                            // Update image counter
                            const ctr = document.getElementById('pdpImgCounter');
                            if (ctr) ctr.textContent = (idx + 1) + '/' + fullImageList.length;

                            const matchedVariant = imageToVariantMap[url];
                            if (matchedVariant) {
                                // Trigger click on variant button to keep pickers in sync
                                const vidx = variants.indexOf(matchedVariant);
                                const targetBtn = document.querySelector('.variant-select-btn[data-idx="' + vidx + '"]');
                                if (targetBtn) {
                                    // Temporarily patch click execution by calling the main logic
                                    targetBtn.click();
                                }

                                // Show variant details
                                const priceEl = document.getElementById('detailPrice');
                                const nameEl = document.getElementById('detailName');
                                const addBtn = document.getElementById('detailAddToCart');
                                if (priceEl) priceEl.textContent = self.formatCurrency(matchedVariant.price || product.selling_price, currency);
                                if (nameEl) nameEl.textContent = product.product_name + ' \u2014 ' + matchedVariant.variant_name;
                                if (addBtn) {
                                    addBtn.setAttribute('data-id', product.id);
                                    addBtn.setAttribute('data-variant-id', matchedVariant.id);
                                    addBtn.setAttribute('data-variant-name', matchedVariant.variant_name);
                                    addBtn.setAttribute('data-variant-price', matchedVariant.price);
                                    addBtn.disabled = matchedVariant.stock <= 0;
                                    addBtn.style.opacity = matchedVariant.stock <= 0 ? '0.5' : '1';
                                    addBtn.onclick = (e) => { if (matchedVariant.stock > 0) self.addToCartWithVariant(product, matchedVariant, e, window.app?.selectedAttributes || null); };
                                }
                                // Highlight variant button
                                document.querySelectorAll('.variant-select-btn').forEach(btn => {
                                    const vidx = btn.dataset.idx;
                                    const isMatch = variants.indexOf(matchedVariant).toString() === vidx;
                                    btn.style.border = isMatch ? '2px solid var(--public-primary)' : '2px solid #ddd';
                                    btn.style.background = isMatch ? 'var(--public-primary)' : 'white';
                                    btn.style.color = isMatch ? 'white' : '#333';
                                });
                                // Update specs to variant attributes
                                const specsBox = document.getElementById('variantSpecsBox');
                                if (specsBox) {
                                    specsBox.innerHTML = '';
                                    let attrs = matchedVariant.attributes || {};
                                    if (typeof attrs === 'string') { try { attrs = JSON.parse(attrs); } catch(e) { attrs = {}; } }
                                    let baseMeta = product.metadata || {};
                                    if (typeof baseMeta === 'string') { try { baseMeta = JSON.parse(baseMeta); } catch(e) { baseMeta = {}; } }
                                    const skip = ['name','product_images','product_image','variant_images','variant_group','has_variants','base_stock'];
                                    const keys = Object.keys(baseMeta).filter(k => !skip.includes(k) && !k.toLowerCase().includes('image'));
                                    if (attrs) { Object.keys(attrs).forEach(k => { if (!keys.includes(k) && !skip.includes(k) && !k.toLowerCase().includes('image')) keys.push(k); }); }
                                    keys.forEach(k => {
                                        const val = (attrs && attrs[k]) || baseMeta[k] || '';
                                        const vs = String(val);
                                        if (val && !Array.isArray(val) && typeof val !== 'object' && !vs.includes('://') && !vs.startsWith('[') && !vs.startsWith('data:')) {
                                            const lbl = k.charAt(0).toUpperCase() + k.slice(1).replace(/_/g, ' ');
                                            specsBox.innerHTML += '<div class="spec-chip"><i class="fas fa-check-circle"></i><span><strong>' + lbl + ':</strong> ' + val + '</span></div>';
                                        }
                                    });
                                }
                            } else {
                                // Trigger click on base button to keep pickers in sync
                                const baseBtn = document.querySelector('.variant-select-btn[data-idx="base"]');
                                if (baseBtn) {
                                    baseBtn.click();
                                }

                                // Show base product details
                                const priceEl = document.getElementById('detailPrice');
                                const nameEl = document.getElementById('detailName');
                                const addBtn = document.getElementById('detailAddToCart');
                                if (priceEl) priceEl.textContent = self.formatCurrency(product.selling_price, currency);
                                if (nameEl) nameEl.textContent = product.product_name;
                                if (addBtn) {
                                    addBtn.setAttribute('data-id', product.id);
                                    addBtn.removeAttribute('data-variant-id');
                                    addBtn.disabled = false;
                                    addBtn.style.opacity = '1';
                                    addBtn.onclick = (e) => { self.addToCart(product.id, e); };
                                }
                                // Highlight base button
                                document.querySelectorAll('.variant-select-btn').forEach(btn => {
                                    if (btn.dataset.idx === 'base') {
                                        btn.style.border = '2px solid var(--public-primary)';
                                        btn.style.background = 'var(--public-primary)';
                                        btn.style.color = 'white';
                                    } else {
                                        btn.style.border = '2px solid #ddd';
                                        btn.style.background = 'white';
                                        btn.style.color = '#333';
                                    }
                                });
                                // Update specs to base product metadata
                                const specsBox = document.getElementById('variantSpecsBox');
                                if (specsBox) {
                                    specsBox.innerHTML = '';
                                    let baseMeta = product.metadata || {};
                                    if (typeof baseMeta === 'string') { try { baseMeta = JSON.parse(baseMeta); } catch(e) { baseMeta = {}; } }
                                    const skip = ['name','product_images','product_image','variant_images','variant_group','has_variants','base_stock'];
                                    for (const [k, val] of Object.entries(baseMeta)) {
                                        const vs = String(val);
                                        if (val && !skip.includes(k) && !k.toLowerCase().includes('image') && !Array.isArray(val) && typeof val !== 'object' && !vs.includes('://') && !vs.startsWith('[') && !vs.startsWith('data:')) {
                                            const lbl = k.charAt(0).toUpperCase() + k.slice(1).replace(/_/g, ' ');
                                            specsBox.innerHTML += '<div class="spec-chip"><i class="fas fa-check-circle"></i><span><strong>' + lbl + ':</strong> ' + val + '</span></div>';
                                        }
                                    }
                                }
                            }
                        };
                        thumbs.appendChild(t);
                    });
                    thumbs.style.display = 'flex';
                }
            };
        }

        // Wait for app to be ready then patch
        let patchInterval = setInterval(function() {
            if (window.app && window.app.openProductDetail) {
                patchApp();
                clearInterval(patchInterval);

                // 3. Patch renderProducts to inject description snippets and specs into product cards
                const origRender = window.app.renderProducts.bind(window.app);
                window.app.renderProducts = function() {
                    origRender();
                    // After render, inject description and specs into each card
                    setTimeout(function() {
                        // Re-run applyCompressedImages in case origRender added new data-compress-src elements
                        if (typeof applyCompressedImages === 'function') applyCompressedImages();

                        const cards = document.querySelectorAll('.public-product-card');
                        cards.forEach(function(card) {
                            // Skip if already patched
                            if (card.querySelector('.public-product-desc')) return;
                            const nameEl = card.querySelector('.public-product-name');
                            const priceEl = card.querySelector('.public-product-price');
                            const imgSection = card.querySelector('.public-product-img');
                            if (!nameEl || !priceEl) return;
                            const name = nameEl.textContent.trim();
                            const product = window.app.products.find(function(p) { return p.product_name === name; });
                            if (!product) return;

                            // Inject specs row (horizontal scroll) between image and details
                            let meta = product.metadata || {};
                            if (typeof meta === 'string') { try { meta = JSON.parse(meta); } catch(e) { meta = {}; } }
                            const skip = ['name','product_images','product_image','variant_images','variant_group','has_variants','base_stock'];
                            const specs = Object.entries(meta).filter(function(entry) {
                                var k = entry[0], v = entry[1];
                                var vs = String(v);
                                return v && !skip.includes(k) && !k.toLowerCase().includes('image') && !Array.isArray(v) && typeof v !== 'object' && !vs.includes('://') && !vs.startsWith('[') && !vs.startsWith('data:');
                            });

                            if (specs.length > 0 && imgSection) {
                                var specsRow = document.createElement('div');
                                specsRow.className = 'public-card-specs';
                                specsRow.innerHTML = specs.map(function(entry) {
                                    return '<span class="public-card-spec-tag">' + entry[0].replace(/_/g,' ') + ': ' + entry[1] + '</span>';
                                }).join('');
                                imgSection.after(specsRow);
                            }

                            // Inject description
                            if (product.description) {
                                var desc = product.description.split('--SPECIFICATIONS--')[0].split('--VARIANT_DATA--')[0].trim();
                                if (desc) {
                                    if (desc.length > 80) desc = desc.substring(0, 80) + '...';
                                    var p = document.createElement('p');
                                    p.className = 'public-product-desc';
                                    p.textContent = desc;
                                    nameEl.after(p);
                                }
                            }
                        });
                    }, 100);
                };

                // Also patch handleFilter to re-inject descriptions
                const origFilter = window.app.handleFilter ? window.app.handleFilter.bind(window.app) : null;
                if (origFilter) {
                    window.app.handleFilter = function() {
                        origFilter();
                        // NOTE: origFilter already calls renderProducts internally.
                        // We do NOT call renderProducts again here to avoid double-render
                        // which was causing data-compress-src to be re-added without applyCompressedImages being called.
                    };
                }

                // 4.5 Patch updateCartUI to also update pdpCartBadge
                var origUpdateCart = window.app.updateCartUI ? window.app.updateCartUI.bind(window.app) : null;
                window.app.updateCartUI = function() {
                    if (origUpdateCart) origUpdateCart();
                    var badge = document.getElementById('pdpCartBadge');
                    if (badge) {
                        var count = (this.cart || []).reduce(function(s, i) { return s + i.quantity; }, 0);
                        if (count > 0) {
                            badge.textContent = count;
                            badge.style.display = 'flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                };
                // Initial update
                window.app.updateCartUI();

                // 4. Continuously watch order modal - replace with form when google_sheet_url is set
                setInterval(function() {
                    var orderModal = document.getElementById('orderModal');
                    if (!orderModal || !orderModal.classList.contains('active')) return;
                    var googleSheetUrl = window.app.shopSettings?.google_sheet_url || '';
                    if (!googleSheetUrl) return;
                    // Check if already replaced (has our form)
                    if (document.getElementById('gsOrderName')) return;
                    window.app.showGoogleSheetOrderForm(googleSheetUrl);
                }, 100);

                // Google Sheet order form method
                window.app.showGoogleSheetOrderForm = function(googleSheetUrl) {
                        const self = this;
                        modal.querySelector('.public-modal-content').innerHTML = `
                            <h3 style="text-align:center;margin-bottom:18px;font-size:1.05rem;font-weight:700;">Complete Your Order</h3>
                            <div style="display:flex;flex-direction:column;gap:12px;">
                                <div>
                                    <label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Your Name *</label>
                                    <input type="text" id="gsOrderName" placeholder="Enter your full name" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;">
                                </div>
                                <div>
                                    <label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">WhatsApp Number *</label>
                                    <input type="tel" id="gsOrderPhone" placeholder="+880 1XXXXXXXXX" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;">
                                </div>
                                <div>
                                    <label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Delivery Location *</label>
                                    <textarea id="gsOrderLocation" placeholder="Enter your full address" rows="2" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;resize:vertical;"></textarea>
                                    <button type="button" id="gsPickLocation" style="margin-top:6px;padding:6px 12px;background:#f5f5f5;border:1px solid #ddd;border-radius:6px;font-size:0.72rem;cursor:pointer;color:#555;">
                                        <i class="fas fa-map-marker-alt"></i> Pick from Map
                                    </button>
                                </div>
                                <div>
                                    <label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Note (Optional)</label>
                                    <input type="text" id="gsOrderNote" placeholder="Any special instructions" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;">
                                </div>
                            </div>
                            <div id="gsOrderStatus" style="margin-top:10px;font-size:0.78rem;text-align:center;min-height:20px;"></div>
                            <div style="display:flex;gap:10px;margin-top:16px;">
                                <button style="flex:1;padding:11px;border-radius:8px;border:1px solid #ddd;background:white;cursor:pointer;font-size:0.85rem;" id="gsCancelOrder">Cancel</button>
                                <button style="flex:2;padding:11px;border-radius:8px;border:none;background:var(--public-primary,#f85606);color:white;font-weight:700;cursor:pointer;font-size:0.88rem;" id="gsConfirmOrder">
                                    <i class="fas fa-check-circle"></i> Confirm Order
                                </button>
                            </div>
                        `;

                        modal.querySelector('#gsPickLocation').addEventListener('click', function() {
                            var locInput = document.getElementById('gsOrderLocation');
                            var mapContainer = document.getElementById('gsMapContainer');

                            if (mapContainer) {
                                mapContainer.style.display = mapContainer.style.display === 'none' ? 'block' : 'none';
                                return;
                            }

                            // Create map container
                            var mc = document.createElement('div');
                            mc.id = 'gsMapContainer';
                            mc.style.cssText = 'margin-top:8px;border-radius:8px;overflow:hidden;border:1px solid #ddd;';
                            mc.innerHTML = '<div id="gsLeafletMap" style="width:100%;height:220px;"></div><div style="display:flex;gap:8px;padding:8px;background:#f9f9f9;border-top:1px solid #eee;align-items:center;"><span id="gsMapCoords" style="flex:1;font-size:0.72rem;color:#666;">Tap on map to pick location</span><button type="button" id="gsMapConfirm" style="padding:6px 14px;background:var(--public-primary,#f85606);color:white;border:none;border-radius:6px;font-size:0.75rem;font-weight:600;cursor:pointer;">Confirm</button></div>';
                            locInput.parentNode.insertBefore(mc, locInput.nextSibling.nextSibling);

                            // Load Leaflet CSS & JS
                            if (!document.getElementById('leafletCSS')) {
                                var css = document.createElement('link');
                                css.id = 'leafletCSS';
                                css.rel = 'stylesheet';
                                css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                                document.head.appendChild(css);
                            }

                            function initMap(lat, lng) {
                                var map = L.map('gsLeafletMap').setView([lat, lng], 15);
                                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                    attribution: '© OSM'
                                }).addTo(map);

                                var marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                                var coordsEl = document.getElementById('gsMapCoords');

                                function updateCoords(latlng) {
                                    var la = latlng.lat.toFixed(6);
                                    var ln = latlng.lng.toFixed(6);
                                    coordsEl.textContent = '📍 Getting address...';
                                    locInput.value = la + ', ' + ln;

                                    // Reverse geocode using free Nominatim API
                                    fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + la + '&lon=' + ln + '&zoom=18&addressdetails=1')
                                        .then(function(r) { return r.json(); })
                                        .then(function(data) {
                                            if (data && data.display_name) {
                                                var addr = data.display_name;
                                                coordsEl.textContent = '📍 ' + addr;
                                                locInput.value = addr + ' (' + la + ', ' + ln + ')';
                                            } else {
                                                coordsEl.textContent = '📍 ' + la + ', ' + ln;
                                            }
                                        })
                                        .catch(function() {
                                            coordsEl.textContent = '📍 ' + la + ', ' + ln;
                                        });
                                }

                                updateCoords(marker.getLatLng());

                                // Drag marker to move
                                marker.on('dragend', function() {
                                    updateCoords(marker.getLatLng());
                                });

                                // Click map to move marker
                                map.on('click', function(e) {
                                    marker.setLatLng(e.latlng);
                                    updateCoords(e.latlng);
                                });

                                document.getElementById('gsMapConfirm').addEventListener('click', function() {
                                    updateCoords(marker.getLatLng());
                                    mc.style.display = 'none';
                                });
                            }

                            function loadLeafletAndInit(lat, lng) {
                                if (window.L) {
                                    initMap(lat, lng);
                                } else {
                                    var script = document.createElement('script');
                                    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                                    script.onload = function() { initMap(lat, lng); };
                                    document.head.appendChild(script);
                                }
                            }

                            // Get user location
                            if (navigator.geolocation) {
                                navigator.geolocation.getCurrentPosition(function(pos) {
                                    loadLeafletAndInit(pos.coords.latitude, pos.coords.longitude);
                                }, function() {
                                    // Default to Dhaka if denied
                                    loadLeafletAndInit(23.8103, 90.4125);
                                }, { enableHighAccuracy: true });
                            } else {
                                loadLeafletAndInit(23.8103, 90.4125);
                            }
                        });

                        modal.querySelector('#gsCancelOrder').addEventListener('click', function() { modal.classList.remove('active'); });

                        modal.querySelector('#gsConfirmOrder').addEventListener('click', function() {
                            var name = document.getElementById('gsOrderName').value.trim();
                            var phone = document.getElementById('gsOrderPhone').value.trim();
                            var location = document.getElementById('gsOrderLocation').value.trim();
                            var note = document.getElementById('gsOrderNote').value.trim();
                            var statusEl = document.getElementById('gsOrderStatus');

                            if (!name || !phone || !location) {
                                statusEl.textContent = 'Please fill all required fields';
                                statusEl.style.color = '#dc2626';
                                return;
                            }

                            var currency = self.shopSettings?.currency || 'INR';
                            var subtotal = self.cart.reduce(function(sum, item) { return sum + (item.price * item.quantity); }, 0);
                            var discount = 0;
                            if (self.appliedDiscount) {
                                var d = self.appliedDiscount;
                                if (subtotal >= d.minOrder) {
                                    discount = d.type === 'percentage' ? (subtotal * d.value / 100) : d.value;
                                }
                            }
                            var total = subtotal - discount;
                            var items = self.cart.map(function(item, idx) { return (idx+1) + '. ' + item.name + ' x' + item.quantity + ' = ' + self.formatCurrency(item.price * item.quantity, currency); }).join('\n');

                            var orderData = {
                                shop_name: self.shopData?.shop_name || '',
                                shop_id: self.shopId,
                                customer_name: name,
                                customer_phone: phone,
                                customer_location: location,
                                customer_note: note,
                                items: items,
                                item_count: self.cart.length,
                                subtotal: subtotal,
                                discount: discount,
                                total: total,
                                currency: currency,
                                order_date: new Date().toLocaleString(),
                                timestamp: new Date().toISOString()
                            };

                            statusEl.textContent = 'Sending order...';
                            statusEl.style.color = '#666';

                            fetch(googleSheetUrl, {
                                method: 'POST',
                                mode: 'no-cors',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(orderData)
                            }).then(function() {
                                statusEl.innerHTML = '<span style="color:#16a34a;">✅ Order placed successfully!</span>';
                                self.cart = [];
                                self.saveCartToStorage();
                                self.updateCartUI();
                                setTimeout(function() {
                                    modal.classList.remove('active');
                                    alert('Your order has been placed! We will contact you on WhatsApp.');
                                }, 1500);
                            }).catch(function(err) {
                                console.error('Order error:', err);
                                statusEl.innerHTML = '<span style="color:#dc2626;">❌ Failed to send. Please try again.</span>';
                            });
                        });

                        modal.classList.add('active');
                };
            }
        }, 200);
    })();
    </script>

    <!-- Google Sheet Order Interceptor (standalone, no dependency on patch) -->
    <script>
    (function() {
        // Wait for app to load, then check ONCE if google sheet is configured
        var gsCheckInterval = setInterval(function() {
            if (!window.app || !window.app.shopSettings) return;
            clearInterval(gsCheckInterval);

            var sheetUrl = window.app.shopSettings.google_sheet_url || '';
            if (!sheetUrl) return; // No google sheet URL = do nothing, use WhatsApp/Telegram

            // Google Sheet is configured - override the order modal behavior
            // Override toggleOrderModal on the app
            window.app.toggleOrderModal = function(show) {
                var modal = document.getElementById('orderModal');
                if (!show) { modal.classList.remove('active'); return; }

                var mc = modal.querySelector('.public-modal-content');
                mc.innerHTML = '<h3 style="text-align:center;margin-bottom:16px;font-size:1.05rem;font-weight:700;">Complete Your Order</h3>' +
                    '<div style="display:flex;flex-direction:column;gap:12px;">' +
                    '<div><label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Your Name *</label><input type="text" id="gsOrderName" placeholder="Enter your full name" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;"></div>' +
                    '<div><label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">WhatsApp Number *</label><input type="tel" id="gsOrderPhone" placeholder="+880 1XXXXXXXXX" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;"></div>' +
                    '<div><label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Delivery Location *</label><textarea id="gsOrderLocation" placeholder="Enter your full address" rows="2" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;resize:vertical;"></textarea><button type="button" id="gsPickLocation2" style="margin-top:6px;padding:6px 12px;background:#f5f5f5;border:1px solid #ddd;border-radius:6px;font-size:0.72rem;cursor:pointer;color:#555;"><i class="fas fa-map-marker-alt"></i> Pick from Map</button></div>' +
                    '<div><label style="font-size:0.78rem;font-weight:600;color:#555;margin-bottom:4px;display:block;">Note (Optional)</label><input type="text" id="gsOrderNote" placeholder="Any special instructions" style="width:100%;padding:11px 14px;border:1px solid #ddd;border-radius:8px;font-size:0.88rem;outline:none;"></div>' +
                    '</div>' +
                    '<div id="gsOrderStatus" style="margin-top:10px;font-size:0.78rem;text-align:center;min-height:20px;"></div>' +
                    '<div style="display:flex;gap:10px;margin-top:16px;">' +
                    '<button style="flex:1;padding:11px;border-radius:8px;border:1px solid #ddd;background:white;cursor:pointer;font-size:0.85rem;" id="gsCancelOrder2">Cancel</button>' +
                    '<button style="flex:2;padding:11px;border-radius:8px;border:none;background:var(--public-primary,#f85606);color:white;font-weight:700;cursor:pointer;font-size:0.88rem;" id="gsConfirmOrder2"><i class="fas fa-check-circle"></i> Confirm Order</button>' +
                    '</div>';

                document.getElementById('gsCancelOrder2').onclick = function() { modal.classList.remove('active'); };

                document.getElementById('gsPickLocation2').onclick = function() {
                    var locInput = document.getElementById('gsOrderLocation');
                    var existingMap = document.getElementById('gsMapContainer2');
                    if (existingMap) { existingMap.style.display = existingMap.style.display === 'none' ? 'block' : 'none'; return; }

                    // Create map container
                    var mc2 = document.createElement('div');
                    mc2.id = 'gsMapContainer2';
                    mc2.style.cssText = 'margin-top:8px;border-radius:8px;overflow:hidden;border:1px solid #ddd;';
                    mc2.innerHTML = '<div id="gsLeafletMap2" style="width:100%;height:200px;"></div><div style="display:flex;gap:8px;padding:8px;background:#f9f9f9;border-top:1px solid #eee;align-items:center;"><span id="gsMapCoords2" style="flex:1;font-size:0.7rem;color:#666;">Tap map to pick location</span><button type="button" id="gsMapConfirm2" style="padding:5px 12px;background:var(--public-primary,#f85606);color:white;border:none;border-radius:6px;font-size:0.72rem;font-weight:600;cursor:pointer;">Confirm</button></div>';
                    locInput.parentNode.appendChild(mc2);

                    // Load Leaflet
                    if (!document.getElementById('leafletCSS2')) {
                        var css = document.createElement('link'); css.id = 'leafletCSS2'; css.rel = 'stylesheet';
                        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(css);
                    }

                    function initMap2(lat, lng) {
                        var map = L.map('gsLeafletMap2').setView([lat, lng], 15);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OSM' }).addTo(map);
                        var marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                        var coordsEl = document.getElementById('gsMapCoords2');

                        function updatePos(latlng) {
                            var la = latlng.lat.toFixed(6), ln = latlng.lng.toFixed(6);
                            coordsEl.textContent = '📍 Getting address...';
                            locInput.value = la + ', ' + ln;
                            fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + la + '&lon=' + ln + '&zoom=18')
                                .then(function(r) { return r.json(); })
                                .then(function(d) {
                                    if (d.display_name) { coordsEl.textContent = '📍 ' + d.display_name.substring(0,60) + '...'; locInput.value = d.display_name + ' (' + la + ', ' + ln + ')'; }
                                    else { coordsEl.textContent = '📍 ' + la + ', ' + ln; }
                                }).catch(function() { coordsEl.textContent = '📍 ' + la + ', ' + ln; });
                        }
                        updatePos(marker.getLatLng());
                        marker.on('dragend', function() { updatePos(marker.getLatLng()); });
                        map.on('click', function(e) { marker.setLatLng(e.latlng); updatePos(e.latlng); });
                        document.getElementById('gsMapConfirm2').onclick = function() { updatePos(marker.getLatLng()); mc2.style.display = 'none'; };
                    }

                    function loadAndInit(lat, lng) {
                        if (window.L) { initMap2(lat, lng); }
                        else { var s = document.createElement('script'); s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; s.onload = function() { initMap2(lat, lng); }; document.head.appendChild(s); }
                    }

                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(function(p) { loadAndInit(p.coords.latitude, p.coords.longitude); }, function() { loadAndInit(23.8103, 90.4125); }, { enableHighAccuracy: true });
                    } else { loadAndInit(23.8103, 90.4125); }
                };

                document.getElementById('gsConfirmOrder2').onclick = function() {
                    var name = document.getElementById('gsOrderName').value.trim();
                    var phone = document.getElementById('gsOrderPhone').value.trim();
                    var location = document.getElementById('gsOrderLocation').value.trim();
                    var note = document.getElementById('gsOrderNote').value.trim();
                    var statusEl = document.getElementById('gsOrderStatus');

                    if (!name || !phone || !location) { statusEl.innerHTML = '<span style="color:#dc2626;">Please fill all required fields</span>'; return; }

                    var app = window.app;
                    var currency = app.shopSettings?.currency || 'BDT';
                    var subtotal = app.cart.reduce(function(s, i) { return s + (i.price * i.quantity); }, 0);
                    var total = subtotal;
                    var items = app.cart.map(function(i, idx) { return (idx+1) + '. ' + i.name + ' x' + i.quantity + ' = ' + app.formatCurrency(i.price * i.quantity, currency); }).join('\n');

                    statusEl.innerHTML = '<span style="color:#666;">Sending order...</span>';

                    fetch(sheetUrl, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            shop_name: app.shopData?.shop_name || '',
                            customer_name: name,
                            customer_phone: phone,
                            customer_location: location,
                            customer_note: note,
                            items: items,
                            total: total,
                            currency: currency,
                            order_date: new Date().toLocaleString(),
                            timestamp: new Date().toISOString()
                        })
                    }).then(function() {
                        statusEl.innerHTML = '<span style="color:#16a34a;">✅ Order placed successfully!</span>';
                        app.cart = [];
                        app.saveCartToStorage();
                        if (app.updateCartUI) app.updateCartUI();
                        setTimeout(function() { modal.classList.remove('active'); alert('Order placed! We will contact you on WhatsApp.'); }, 1500);
                    }).catch(function() {
                        statusEl.innerHTML = '<span style="color:#dc2626;">❌ Failed. Please try again.</span>';
                    });
                };

                modal.classList.add('active');
            };
        }, 300);
    })();
    </script>

    <!-- Product Sharing Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const shopName = document.getElementById('publicHeaderName')?.textContent || 'Our Shop';

            // Function to handle sharing
            async function handleShare(name, price, id) {
                const currentUrl = new URL(window.location.href);
                // Try to add product ID to URL if it doesn't already have it
                if (id) currentUrl.searchParams.set('product', id);

                const shareText = `Check out "${name}" at ${shopName}!\nPrice: ${price}\n\n`;
                const shareUrl = currentUrl.toString();

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: name,
                            text: shareText,
                            url: shareUrl
                        });
                    } catch (err) {
                        if (err.name !== 'AbortError') console.error('Error sharing:', err);
                    }
                } else {
                    // Fallback for desktop/unsupported browsers
                    const waUrl = `https://wa.me/?text=${encodeURIComponent(shareText + shareUrl)}`;
                    window.open(waUrl, '_blank');
                }
            }

            // Function to inject share buttons into product cards
            function injectShareButtons() {
                const cards = document.querySelectorAll('.public-product-card');
                cards.forEach(card => {
                    if (card.querySelector('.public-share-btn-card')) return;

                    const shareBtn = document.createElement('button');
                    shareBtn.className = 'public-share-btn-card';
                    shareBtn.innerHTML = '<i class="fas fa-share-alt"></i>';
                    shareBtn.title = 'Share this product';

                    // Get details from card
                    const name = card.querySelector('.public-product-name')?.textContent || 'Product';
                    const price = card.querySelector('.public-product-price')?.textContent || '';
                    const productId = card.getAttribute('data-id') || '';

                    shareBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        handleShare(name, price, productId);
                    });

                    // Prepend to card (top right)
                    card.appendChild(shareBtn);
                });
            }

            // Watch for new products being loaded (since it's dynamic)
            const observer = new MutationObserver((mutations) => {
                let shouldUpdate = false;
                mutations.forEach(m => {
                    if (m.addedNodes.length > 0) shouldUpdate = true;
                });
                if (shouldUpdate) injectShareButtons();
            });

            const grid = document.getElementById('productsGrid');
            if (grid) {
                observer.observe(grid, { childList: true });
                // Initial check
                injectShareButtons();
            }

            // Handle share button in Detail Modal
            const modalShareBtn = document.getElementById('detailShareProduct');
            if (modalShareBtn) {
                modalShareBtn.addEventListener('click', () => {
                    const name = document.getElementById('detailName')?.textContent || 'Product';
                    const price = document.getElementById('detailPrice')?.textContent || '';
                    // Try to find the product ID from the add button or state
                    const addToCartBtn = document.getElementById('detailAddToCart');
                    const productId = addToCartBtn?.getAttribute('data-id') || '';

                    handleShare(name, price, productId);
                });
            }
        });
    </script>

    <!-- STANDALONE: Extra contacts footer loader — independent of all other patches -->
    <script>
    (function() {
        var iconMap = {
            phone:     { icon: 'fas fa-phone',     href: function(v) { return 'tel:' + v; },                                        target: '' },
            whatsapp:  { icon: 'fab fa-whatsapp',  href: function(v) { return 'https://wa.me/' + v.replace(/\D/g,''); },            target: '_blank' },
            telegram:  { icon: 'fab fa-telegram',  href: function(v) { return 'https://t.me/' + v.replace('@',''); },               target: '_blank' },
            email:     { icon: 'fas fa-envelope',  href: function(v) { return 'mailto:' + v; },                                    target: '' },
            instagram: { icon: 'fab fa-instagram', href: function(v) { return v.startsWith('http') ? v : 'https://instagram.com/' + v.replace('@',''); }, target: '_blank' },
            facebook:  { icon: 'fab fa-facebook',  href: function(v) { return v.startsWith('http') ? v : 'https://facebook.com/' + v; }, target: '_blank' },
            website:   { icon: 'fas fa-globe',     href: function(v) { return v.startsWith('http') ? v : 'https://' + v; },        target: '_blank' },
            custom:    { icon: 'fas fa-link',      href: function(v) { return v.startsWith('http') ? v : '#'; },                   target: '_blank' },
        };

        function showFallback() {
            ['footerAddressRow','footerPhoneRow','footerWARow'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = '';
            });
        }

        function renderContacts(contacts) {
            var container = document.getElementById('extraContactsFooter');
            if (!container) return;
            if (!Array.isArray(contacts) || contacts.length === 0) { showFallback(); return; }
            container.innerHTML = contacts.map(function(c) {
                var map = iconMap[c.type] || iconMap.custom;
                var href = map.href(c.value || '');
                var display = c.label ? c.label : c.value;
                return '<p><a href="' + href + '"' + (map.target ? ' target="' + map.target + '"' : '') +
                       ' style="color:inherit;display:inline-flex;align-items:center;gap:10px;">' +
                       '<i class="' + map.icon + '"></i><span>' + display + '</span></a></p>';
            }).join('');
        }

        // Poll until both supabaseClient and shopId are available
        var tries = 0;
        var poll = setInterval(function() {
            tries++;
            if (tries > 100) { clearInterval(poll); showFallback(); return; } // 10s timeout

            var shopId = window.app && window.app.shopId;
            if (!shopId || typeof supabaseClient === 'undefined') return;
            clearInterval(poll);

            supabaseClient
                .from('shop_settings')
                .select('extra_contacts')
                .eq('shop_id', shopId)
                .maybeSingle()
                .then(function(res) {
                    if (res.error) { console.warn('extra_contacts fetch error:', res.error.message); showFallback(); return; }
                    var contacts = (res.data && res.data.extra_contacts) || [];
                    if (typeof contacts === 'string') { try { contacts = JSON.parse(contacts); } catch(e) { contacts = []; } }
                    renderContacts(Array.isArray(contacts) ? contacts : []);
                })
                .catch(function(e) { console.warn('extra_contacts catch:', e); showFallback(); });
        }, 100);
    })();
    </script>
</body>



</html>




